# LOCAL DEVELOPMENT ONLY. Copy to .env. Never commit real credentials.
# Compose uses internal service hostnames; these ports are published on loopback.
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=12000
MONGO_HOST_PORT=27017
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MONGO_DB_NAME=cyphernod
S3_BUCKET=cyphernod
# Local Maven/VS Code runs detect credentials from the existing MinIO/Silo container.
# Leave these blank for discovery; fill them only for an explicitly configured account.
# Docker Compose supplies its local development defaults when these are blank.
S3_ACCESS_KEY=
S3_SECRET_KEY=
SESSION_SECURE=false
# Must match the browser URL when using the Vite proxy; change when using 127.0.0.1 or another port.
ALLOWED_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=104857600

# For running the backend and Vite directly on the host, export these variables.
# Compose sets its own internal MONGO_URL and S3_ENDPOINT instead.
PORT=12000
MONGO_URL=mongodb://127.0.0.1:27017
S3_ENDPOINT=http://127.0.0.1:9000
# UPLOAD_DIR is optional; Java uses its platform-specific temporary directory.
API_PROXY_TARGET=http://127.0.0.1:12000

# Isolated automated-test services (compose.test.yaml).
TEST_MONGO_PORT=27018
TEST_MINIO_PORT=19000
TEST_MINIO_CONSOLE_PORT=19001

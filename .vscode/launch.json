{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Cyphernod backend (local)",
            "request": "launch",
            "mainClass": "org.mahat.Loader",
            "cwd": "${workspaceFolder}/BackEnd",
            "env": {
                "CYPHERNOD_PROFILE": "local",
                "UPLOAD_DIR": "${workspaceFolder}/BackEnd/target/uploads"
            },
            "console": "integratedTerminal"
        }
    ]
}
